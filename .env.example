# Bot principal
APP_ENV=development
TOKEN=
# Opcional: si existe, tiene prioridad sobre TOKEN
ECONOMY_TOKEN=
ALLOWED_ROLE_ID=0
AVALONIAN_LOG_CHANNEL_ID=0
ENABLE_MEMBER_INTENT=1
ENABLE_VOICE_INTENT=1
ENABLE_MESSAGE_CONTENT_INTENT=0

# Musica / voz
# Si MUSIC_ENABLED=false, el bot no carga el cog de musica ni exige FFmpeg.
# Si MUSIC_ENABLED=true, FFmpeg debe existir en PATH o en FFMPEG_PATH.
MUSIC_ENABLED=true
FFMPEG_PATH=

# Dashboard
# Entorno legacy del dashboard. Si esta vacio, hereda APP_ENV.
# Usa APP_ENV=production y/o DASHBOARD_ENV=production en VPS/systemd.
DASHBOARD_ENV=development
# Bind interno del dashboard. En produccion debe quedarse en 127.0.0.1:8000
# y publicarse solo mediante reverse proxy. No uses 0.0.0.0 en VPS.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
# Obligatorio para arrancar el dashboard.
# Genera un valor aleatorio fuera del repo; no reutilices TOKEN.
DASHBOARD_SESSION_SECRET=
# En produccion HTTPS, activar para emitir cookies con atributo Secure.
# Dejar en false para desarrollo local por HTTP.
DASHBOARD_COOKIE_SECURE=false
# Refuerzo del panel administrativo
# En produccion son obligatorios: hash Argon2id, pepper y allowlist.
# El hash se genera con la clave admin + pepper, fuera del codigo.
DASHBOARD_ADMIN_PASSWORD_HASH=
DASHBOARD_ADMIN_PASSWORD_PEPPER=
# IDs de usuarios Discord permitidos para elevar acceso administrativo.
# Lista separada por comas, por ejemplo: 123456789012345678,234567890123456789
DASHBOARD_ADMIN_DEVELOPER_IDS=
# 10 a 15 minutos recomendados
DASHBOARD_ADMIN_ELEVATED_TTL_SECONDS=900
DASHBOARD_ADMIN_MAX_ATTEMPTS=5
DASHBOARD_ADMIN_ATTEMPT_WINDOW_SECONDS=900
DASHBOARD_ADMIN_LOCKOUT_SECONDS=900

# OAuth del dashboard
DASHBOARD_CLIENT_ID=
DASHBOARD_CLIENT_SECRET=
DASHBOARD_REDIRECT_URI=http://localhost:8000/oauth/callback
DASHBOARD_PUBLIC_URL=http://localhost:8000

# Cache de metadata de Discord usada por el dashboard
DISCORD_METADATA_ROLES_TTL_SECONDS=900
DISCORD_METADATA_CHANNELS_TTL_SECONDS=300
DISCORD_METADATA_CATEGORIES_TTL_SECONDS=300
DISCORD_METADATA_EMOJIS_TTL_SECONDS=1800
DISCORD_METADATA_STALE_FALLBACK_SECONDS=3600

# Albion Online Data - precios de mercado para loot
ALBION_MARKET_SERVER=west
ALBION_MARKET_LOCATIONS=Black Market,Caerleon,Bridgewatch,Martlock,Lymhurst,Fort Sterling,Thetford,Brecilien
ALBION_MARKET_QUALITIES=1
ALBION_MARKET_CACHE_TTL_SECONDS=21600
ALBION_MARKET_TIMEOUT_SECONDS=8

# Backups runtime
# En produccion debe estar fuera del directorio del proyecto/data.
BOT_NEOX_BACKUP_DIR=/var/backups/bot-neox
BOT_NEOX_BACKUP_RETENTION=7
# Opcional: lista separada por comas de JSON criticos relativos a data/.
# No incluyas .env ni archivos con secretos.
BOT_NEOX_BACKUP_JSON_FILES=
# Opcional: log adicional del script; systemd ya guarda stdout/stderr en journald.
BOT_NEOX_BACKUP_LOG_FILE=
