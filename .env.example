# Bot principal
TOKEN=your_discord_bot_token
# Opcional: si existe, tiene prioridad sobre TOKEN
ECONOMY_TOKEN=
ALLOWED_ROLE_ID=0
AVALONIAN_LOG_CHANNEL_ID=0
ENABLE_MEMBER_INTENT=1
ENABLE_VOICE_INTENT=1
ENABLE_MESSAGE_CONTENT_INTENT=0

# Dashboard
# Obligatorio: no se reutiliza el token del bot como secreto de sesion
DASHBOARD_SESSION_SECRET=replace_with_a_long_random_secret

# OAuth del dashboard
DASHBOARD_CLIENT_ID=your_dashboard_client_id
DASHBOARD_CLIENT_SECRET=your_dashboard_client_secret
DASHBOARD_REDIRECT_URI=http://localhost:8000/oauth/callback
DASHBOARD_PUBLIC_URL=http://localhost:8000

# Cache de metadata de Discord usada por el dashboard
DISCORD_METADATA_ROLES_TTL_SECONDS=900
DISCORD_METADATA_CHANNELS_TTL_SECONDS=300
DISCORD_METADATA_CATEGORIES_TTL_SECONDS=300
DISCORD_METADATA_EMOJIS_TTL_SECONDS=1800
DISCORD_METADATA_STALE_FALLBACK_SECONDS=3600

# Albion Online Data - precios de mercado para loot
ALBION_MARKET_SERVER=west
ALBION_MARKET_LOCATIONS=Black Market,Caerleon,Bridgewatch,Martlock,Lymhurst,Fort Sterling,Thetford,Brecilien
ALBION_MARKET_QUALITIES=1
ALBION_MARKET_CACHE_TTL_SECONDS=21600
ALBION_MARKET_TIMEOUT_SECONDS=8
