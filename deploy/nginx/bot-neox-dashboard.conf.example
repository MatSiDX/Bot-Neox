# Replace this placeholder with your dashboard domain.
server {
    listen 80;
    listen [::]:80;
    server_name dashboard.tudominio.com;

    # Use this HTTP-only example for first boot or pair it with Certbot.
    # For HTTPS, keep only ports 80/443 public and proxy to 127.0.0.1:8000.
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

